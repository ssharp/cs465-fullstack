<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Contact - Travlr Getaways Website Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header }}
			<div id="contents">
				<div class="box">
					<div>
						<div id="contact" class="body">
							<h1>Contact</h1>
							<form action="http://localhost:3000/api/contact" method="post">
								<table>
									<tbody>
										<tr>
											<td>Name:</td>
											<td><input type="text" name="name" class="txtfield"></td>
										</tr> <tr>
											<td>Email:</td>
											<td><input type="text" name="email" class="txtfield" formControlName="email"></td>
										</tr> <tr>
											<td>Tag:</td>
											<td><input type="text" name="tag" class="txtfield" style="text-transform: uppercase;"></td>
										</tr> <tr>
											<td class="txtarea">Message:</td>
											<td><textarea name="message"></textarea></td>
										</tr> <tr>
											<td></td>
											<td><input type="submit" value="" class="btn"></td>
										</tr>
									</tbody>
								</table>
							</form>
							<h2>Travlr Getaways</h2>
							<p>
								<span>Address:</span> 123 Lorem Ipsum Cove, Sed Ut City, LI 12345
							</p>
							<p>
								<span>Tags:</span> BUGS, FAQS, SUPPORT, LEGAL
							</p>
							<p>
								<span>Phone Number:</span> 1-800-999-9999
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer}}
	</div>
</body>
</html>